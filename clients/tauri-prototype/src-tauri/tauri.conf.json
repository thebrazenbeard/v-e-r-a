{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vera Desktop Preview",
  "version": "0.1.0",
  "identifier": "com.vera.desktop.preview",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{"title": "Vera Desktop Preview", "width": 900, "height": 710, "minWidth": 560, "minHeight": 460, "label": "main"}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
