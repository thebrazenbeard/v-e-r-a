{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base_status": {
      "enum": [
        "NOT_BASE_READY",
        "BASE_READY"
      ]
    },
    "modules": {
      "type": "array"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "operational_state_loaded_before_freeze": {
      "const": false
    },
    "package": {
      "additionalProperties": false,
      "properties": {
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "package_id": {
          "const": "BT2_SEVEN_ROLE_TRAINING"
        },
        "role_identity": {
          "const": "Seven"
        },
        "training_package_version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "training_package_version",
        "role_identity",
        "manifest_sha256"
      ],
      "type": "object"
    },
    "qualification": {
      "type": "object"
    },
    "schema": {
      "const": "BT2_SEVEN_TRAINING_CHECKPOINT_V1"
    },
    "training_source": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "repository": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit",
        "path"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema",
    "package",
    "training_source",
    "modules",
    "qualification",
    "operational_state_loaded_before_freeze",
    "base_status"
  ],
  "title": "BT2 Seven Training Checkpoint V1",
  "type": "object"
}
