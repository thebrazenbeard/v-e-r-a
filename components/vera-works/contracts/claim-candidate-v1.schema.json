{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim-candidate-v1.schema.json",
  "title": "Vera Works Claim Candidate V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "title",
    "source_id",
    "source_uri",
    "source_class",
    "source_digest",
    "observed_at",
    "eligibility_class",
    "beneficiary_type",
    "evidence_refs"
  ],
  "properties": {
    "claim_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "source_uri": {"type": "string", "minLength": 1},
    "source_class": {
      "enum": ["GOVERNMENT", "REGULATOR", "COURT_ADMIN", "FIRST_PARTY_PROTOCOL", "OFFICIAL", "SECONDARY", "UNKNOWN"]
    },
    "source_digest": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "observed_at": {"type": "string", "minLength": 20},
    "eligibility_class": {"enum": ["ENTITLED", "OPEN_CLAIM", "AMBIGUOUS", "NOT_OURS", "UNKNOWN"]},
    "beneficiary_type": {"enum": ["WALLET", "IDENTITY", "OPEN_CLASS", "UNKNOWN"]},
    "beneficiary_locator": {"type": ["string", "null"]},
    "beneficiary_match": {"enum": ["VERIFIED", "UNVERIFIED", "NO_MATCH"]},
    "opens_at": {"type": ["string", "null"]},
    "closes_at": {"type": ["string", "null"]},
    "gross_amount": {"type": ["string", "null"]},
    "currency": {"type": ["string", "null"]},
    "fee_estimate": {"type": "string"},
    "tax_reserve_estimate": {"type": "string"},
    "requires_wallet_signature": {"type": "boolean"},
    "requires_identity_verification": {"type": "boolean"},
    "requires_account_creation": {"type": "boolean"},
    "requires_terms_acceptance": {"type": "boolean"},
    "human_communication_required": {"type": "boolean"},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "notes": {"type": "string"}
  }
}
