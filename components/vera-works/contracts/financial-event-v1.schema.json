{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "financial-event-v1.schema.json",
  "title": "Vera Works Financial Event Payload V1",
  "type": "object",
  "additionalProperties": true,
  "required": ["currency"],
  "properties": {
    "currency": {"type": "string", "minLength": 3, "maxLength": 3},
    "gross": {"type": "string"},
    "fees": {"type": "string"},
    "tax_reserve": {"type": "string"},
    "net": {"type": "string"},
    "amount": {"type": "string"},
    "purpose": {"type": "string"},
    "reverses_event_id": {"type": "string"}
  }
}
