{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yield-candidate-v1.schema.json",
  "title": "Vera Works Yield Candidate V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "yield_id",
    "title",
    "resource_alias",
    "resource_kind",
    "reward_model",
    "source_class",
    "source_uri",
    "source_digest",
    "terms_uri",
    "terms_digest",
    "terms_state",
    "observed_at",
    "quote_observed_at",
    "quote_digest",
    "max_quote_age_seconds",
    "economics_state",
    "gross_usd_per_hour",
    "estimated_power_watts",
    "platform_fee_usd_per_hour",
    "network_cost_usd_per_hour",
    "wear_reserve_usd_per_hour",
    "other_cost_usd_per_hour",
    "upfront_cost_usd",
    "capital_locked_usd",
    "customer_acquisition_required",
    "human_communication_required",
    "requires_account_creation",
    "requires_terms_acceptance",
    "requires_identity_verification",
    "requires_wallet_signature",
    "requires_installation",
    "requires_network_exposure",
    "evidence_refs"
  ],
  "properties": {
    "yield_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "resource_alias": {"type": "string", "minLength": 1},
    "resource_kind": {"enum": ["CPU", "GPU", "STORAGE", "BANDWIDTH", "CAPITAL", "UPTIME", "OTHER"]},
    "reward_model": {
      "enum": [
        "PROTOCOL_EMISSION",
        "POOL_REWARD",
        "NETWORK_SUBSIDY",
        "POSTED_REWARD",
        "USEFUL_COMPUTE_REWARD",
        "STAKING_YIELD",
        "MARKETPLACE_DEMAND",
        "CUSTOMER_SALE"
      ]
    },
    "source_class": {
      "enum": ["FIRST_PARTY_PROTOCOL", "OFFICIAL_POOL", "OFFICIAL_NETWORK", "OFFICIAL_MARKETPLACE", "OFFICIAL_REWARD_PROGRAM", "SECONDARY", "UNKNOWN"]
    },
    "source_uri": {"type": "string", "minLength": 1},
    "source_digest": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "terms_uri": {"type": "string", "minLength": 1},
    "terms_digest": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "terms_state": {
      "enum": ["NOT_APPLICABLE", "VERIFIED_ALLOWED", "VERIFIED_PROHIBITED", "UNKNOWN"]
    },
    "observed_at": {"type": "string", "minLength": 20},
    "quote_observed_at": {"type": "string", "minLength": 20},
    "quote_digest": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "max_quote_age_seconds": {"type": "integer", "minimum": 1},
    "economics_state": {"enum": ["VERIFIED", "ESTIMATED", "UNKNOWN"]},
    "gross_usd_per_hour": {"type": ["string", "null"]},
    "estimated_power_watts": {"type": ["string", "null"]},
    "platform_fee_usd_per_hour": {"type": "string"},
    "network_cost_usd_per_hour": {"type": "string"},
    "wear_reserve_usd_per_hour": {"type": "string"},
    "other_cost_usd_per_hour": {"type": "string"},
    "upfront_cost_usd": {"type": "string"},
    "capital_locked_usd": {"type": "string"},
    "minimum_vram_gb": {"type": ["string", "null"]},
    "minimum_ram_gb": {"type": ["string", "null"]},
    "minimum_disk_gb": {"type": ["string", "null"]},
    "minimum_upload_mbps": {"type": ["string", "null"]},
    "minimum_cpu_threads": {"type": ["integer", "null"], "minimum": 0},
    "customer_acquisition_required": {"type": "boolean"},
    "human_communication_required": {"type": "boolean"},
    "requires_account_creation": {"type": "boolean"},
    "requires_terms_acceptance": {"type": "boolean"},
    "requires_identity_verification": {"type": "boolean"},
    "requires_wallet_signature": {"type": "boolean"},
    "requires_installation": {"type": "boolean"},
    "requires_network_exposure": {"type": "boolean"},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "notes": {"type": "string"}
  }
}
