diff --git a/scripts/check_markdown_links_test.py b/scripts/check_markdown_links_test.py
new file mode 100644
index 0000000..645bc0b
--- /dev/null
+++ b/scripts/check_markdown_links_test.py
@@ -0,0 +1,65 @@
+from __future__ import annotations
+
+import importlib.util
+import tempfile
+import unittest
+from pathlib import Path
+
+MODULE_PATH = Path(__file__).with_name("check_markdown_links.py")
+SPEC = importlib.util.spec_from_file_location("check_markdown_links", MODULE_PATH)
+assert SPEC and SPEC.loader
+CHECKER = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(CHECKER)
+
+
+class MarkdownLinkCheckerTests(unittest.TestCase):
+    def test_broken_relative_link_is_reported_and_nonlocal_links_are_ignored(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            (root / "docs").mkdir()
+            (root / "docs" / "ok.md").write_text("# ok" + chr(10), encoding="utf-8")
+            (root / "README.md").write_text(
+                chr(10).join(
+                    [
+                        "[ok](docs/ok.md#section)",
+                        "[broken](docs/missing.md)",
+                        "[external](https://example.com/missing.md)",
+                        "[anchor](#local-heading)",
+                        "[root path](/docs/generated)",
+                    ]
+                ),
+                encoding="utf-8",
+            )
+
+            broken = CHECKER.find_broken_links(root)
+
+            self.assertEqual(len(broken), 1)
+            self.assertEqual(broken[0][0].as_posix(), "README.md")
+            self.assertEqual(broken[0][2], "docs/missing.md")
+
+    def test_reference_links_and_fenced_examples_are_checked(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            fence = "`" * 3
+            (root / "README.md").write_text(
+                chr(10).join(
+                    [
+                        "[guide]: docs/missing.md",
+                        fence + "markdown",
+                        "![preview](assets/missing.svg)",
+                        fence,
+                    ]
+                ),
+                encoding="utf-8",
+            )
+
+            broken = CHECKER.find_broken_links(root)
+
+            self.assertEqual(
+                [(item[1], item[2]) for item in broken],
+                [(1, "docs/missing.md"), (3, "assets/missing.svg")],
+            )
+
+
+if __name__ == "__main__":
+    unittest.main()
