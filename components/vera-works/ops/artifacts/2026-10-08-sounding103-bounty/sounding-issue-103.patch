index 0000000..3b6e2fa
--- /dev/null
+++ b/scripts/check_markdown_links.py
@@ -0,0 +1,91 @@
+#!/usr/bin/env python3
+"""Fail when a Markdown file contains a broken repository-relative link."""
+
+from __future__ import annotations
+
+import argparse
+import re
+import sys
+from pathlib import Path
+from urllib.parse import unquote, urlsplit
+
+INLINE_LINK = re.compile(r"!?\[[^\]]*\]\(([^)]+)\)")
+REFERENCE_LINK = re.compile(r"^\s*\[[^\]]+\]:\s*(\S+)")
+
+
+def _target_token(raw: str) -> str:
+    target = raw.strip()
+    if target.startswith("<"):
+        end = target.find(">")
+        return target[1:end] if end != -1 else target[1:]
+    return target.split(None, 1)[0] if target else ""
+
+
+def _relative_path(target: str) -> str | None:
+    if not target or target.startswith(("#", "//")):
+        return None
+
+    parsed = urlsplit(target)
+    if parsed.scheme or parsed.netloc:
+        return None
+
+    path = unquote(parsed.path)
+    if not path or path.startswith("/"):
+        return None
+    return path
+
+
+def find_broken_links(root: Path) -> list[tuple[Path, int, str, Path]]:
+    root = root.resolve()
+    broken: list[tuple[Path, int, str, Path]] = []
+
+    for markdown in sorted(root.rglob("*.md")):
+        if ".git" in markdown.parts:
+            continue
+
+        text = markdown.read_text(encoding="utf-8", errors="replace")
+        for line_number, line in enumerate(text.splitlines(), 1):
+            targets = [_target_token(match.group(1)) for match in INLINE_LINK.finditer(line)]
+            reference = REFERENCE_LINK.match(line)
+            if reference:
+                targets.append(_target_token(reference.group(1)))
+
+            for target in targets:
+                relative = _relative_path(target)
+                if relative is None:
+                    continue
+
+                candidate = (markdown.parent / relative).resolve()
+                if not candidate.exists():
+                    broken.append((markdown.relative_to(root), line_number, target, candidate))
+
+    return broken
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("root", nargs="?", default=".", help="repository root")
+    args = parser.parse_args(argv)
+
+    root = Path(args.root)
+    broken = find_broken_links(root)
+    if not broken:
+        print("All repository-relative Markdown links resolve.")
+        return 0
+
+    for source, line_number, target, candidate in broken:
+        try:
+            resolved = candidate.relative_to(root.resolve())
+        except ValueError:
+            resolved = candidate
+        print(
+            f"{source}:{line_number}: broken relative link {target!r} -> {resolved}",
+            file=sys.stderr,
+        )
+
+    print(f"{len(broken)} broken relative Markdown link(s).", file=sys.stderr)
+    return 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
