 ..._wallet_blocklist_constraints_postgres.sql |  7 ++
 src/services/walletBlocklist.ts               |  7 ++
 tests/services/walletBlocklist.test.ts        | 64 +++++++++++++++++++
 4 files changed, 101 insertions(+)
