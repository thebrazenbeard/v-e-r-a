From bff1a0a0480bd3b3f6d2720dc725b39bcffa2b79 Mon Sep 17 00:00:00 2001
From: Patrick Sims <234958733+thebrazenbeard@users.noreply.github.com>
Date: Thu, 8 Oct 2026 16:49:50 -0400
Subject: [PATCH] sounding104-go-mod-tidy-ci-guard

---
 .github/workflows/ci.yml | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 94eebef..884c046 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -45,6 +45,16 @@ jobs:
           cache: true
           cache-dependency-path: go.sum
 
+      # Keep module metadata canonical. If this fails, run `go mod tidy`
+      # locally and commit the resulting go.mod/go.sum changes.
+      - name: verify go modules are tidy
+        run: |
+          go mod tidy
+          if ! git diff --exit-code -- go.mod go.sum; then
+            echo "::error::go.mod or go.sum is not tidy. Run 'go mod tidy' locally and commit the result."
+            exit 1
+          fi
+
       - name: gofmt
         run: |
           unformatted=$(gofmt -l .)
-- 
