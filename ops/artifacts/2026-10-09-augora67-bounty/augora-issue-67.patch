 frontend/index.html |  8 ++++----
 frontend/script.js  | 10 ++++++++--
 2 files changed, 12 insertions(+), 6 deletions(-)

diff --git a/frontend/index.html b/frontend/index.html
index d5221c0..2db7d23 100644
--- a/frontend/index.html
+++ b/frontend/index.html
@@ -77,10 +77,10 @@
         <div class="container">
           <div class="strip-heading"><div><span class="eyebrow">The network behind every trade</span><h2 id="network-title">Stellar, right now</h2></div><span id="network-state" class="status-pill">Connecting</span></div>
           <div class="metric-grid">
-            <article><svg><use href="#i-layers" /></svg><div><span>Latest ledger</span><strong id="latest-ledger">—</strong></div></article>
-            <article><svg><use href="#i-clock" /></svg><div><span>Ledger age</span><strong id="ledger-age">—</strong></div></article>
-            <article><svg><use href="#i-chart" /></svg><div><span>Operations / ledger</span><strong id="operation-count">—</strong></div></article>
-            <article><svg><use href="#i-globe" /></svg><div><span>Network</span><strong>Stellar mainnet</strong></div></article>
+            <article><svg><use href="#i-layers" /></svg><div><span>Latest Testnet ledger</span><strong id="latest-ledger">—</strong></div></article>
+            <article><svg><use href="#i-clock" /></svg><div><span>Testnet ledger age</span><strong id="ledger-age">—</strong></div></article>
+            <article><svg><use href="#i-chart" /></svg><div><span>Operations / Testnet ledger</span><strong id="operation-count">—</strong></div></article>
+            <article><svg><use href="#i-globe" /></svg><div><span>Network</span><strong id="network-name">—</strong></div></article>
           </div>
         </div>
       </section>
diff --git a/frontend/script.js b/frontend/script.js
index 5251e25..fb9fc61 100644
--- a/frontend/script.js
+++ b/frontend/script.js
@@ -1,6 +1,10 @@
 import { placeBet, reducePosition, checkTransactionStatus } from "./soroban.js";
 
-const HORIZON_URL = "https://horizon.stellar.org";
+const STELLAR_NETWORK = Object.freeze({
+  name: "Stellar Testnet",
+  horizonUrl: "https://horizon-testnet.stellar.org",
+});
+const HORIZON_URL = STELLAR_NETWORK.horizonUrl;
 const COINGECKO_URL = "https://api.coingecko.com/api/v3";
 const POSITION_STORAGE_KEY = "stellartrade:session-positions";
 const TESTNET_EXPLORER_PREFIX = "https://stellar.expert/explorer/testnet/tx/";
@@ -68,6 +72,8 @@ async function fetchJson(url, timeout = 9000) {
 }
 
 async function updateNetwork() {
+  $("#network-title").textContent = `${STELLAR_NETWORK.name}, right now`;
+  $("#network-name").textContent = STELLAR_NETWORK.name;
   try {
     const data = await fetchJson(`${HORIZON_URL}/ledgers?order=desc&limit=1`);
     const ledger = data._embedded.records[0];
@@ -77,7 +83,7 @@ async function updateNetwork() {
     $("#operation-count").textContent = formatNumber(ledger.operation_count);
     $("#network-state").textContent = "Live";
     $("#network-state").classList.add("online");
-    $("#connection-label").textContent = "Live on Stellar mainnet";
+    $("#connection-label").textContent = `Live on ${STELLAR_NETWORK.name}`;
     setUpdated();
   } catch (error) {
     $("#network-state").textContent = "Unavailable";
