+class _StubHttpClient:
+    def __init__(self, *, get_status: int = 200, post_status: int = 200, offline: bool = False):
+        self.get_status = get_status
+        self.post_status = post_status
+        self.offline = offline
+        self.get_calls = 0
+        self.post_calls = 0
+
+    def get(self, url, params=None):
+        self.get_calls += 1
+        request = httpx.Request("GET", url)
+        if self.offline:
+            raise httpx.ConnectError("offline", request=request)
+        return httpx.Response(self.get_status, request=request, json={"ok": True})
+
+    def post(self, url, json=None):
+        self.post_calls += 1
+        request = httpx.Request("POST", url)
+        if self.offline:
+            raise httpx.ConnectError("offline", request=request)
+        payload = {"result": {"ok": True}} if self.post_status < 400 else {}
+        return httpx.Response(self.post_status, request=request, json=payload)
+
+
+def test_http_client_factory_reuses_one_client_for_same_timeout(monkeypatch):
+    created = []
+
+    class FakeClient:
+        def __init__(self, *, timeout):
+            self.timeout = timeout
+            created.append(self)
+
+    stellar._http_client.cache_clear()
+    monkeypatch.setattr(stellar.httpx, "Client", FakeClient)
+    try:
+        first = stellar._http_client(8.0)
+        second = stellar._http_client(8.0)
+        assert first is second
+        assert len(created) == 1
+        assert created[0].timeout == 8.0
+    finally:
+        stellar._http_client.cache_clear()
+
+
+def test_get_and_rpc_share_the_cached_client_path(monkeypatch):
+    shared = _StubHttpClient()
+    monkeypatch.setattr(stellar, "_http_client", lambda timeout: shared)
+    settings = Settings()
+
+    assert stellar._get("https://example.invalid/account", settings=settings) == {"ok": True}
+    assert stellar._rpc("getHealth", {}, settings=settings) == {"ok": True}
+    assert shared.get_calls == 1
+    assert shared.post_calls == 1
+
+
+@pytest.mark.parametrize(("status", "expected"), [(404, 404), (500, 502)])
+def test_get_preserves_http_status_mapping(monkeypatch, status, expected):
+    monkeypatch.setattr(stellar, "_http_client", lambda timeout: _StubHttpClient(get_status=status))
+
+    with pytest.raises(HTTPException) as exc_info:
+        stellar._get("https://example.invalid/account", settings=Settings())
+
+    assert exc_info.value.status_code == expected
+
+
+def test_get_preserves_offline_503_mapping(monkeypatch):
+    monkeypatch.setattr(stellar, "_http_client", lambda timeout: _StubHttpClient(offline=True))
+
+    with pytest.raises(HTTPException) as exc_info:
+        stellar._get("https://example.invalid/account", settings=Settings())
+
+    assert exc_info.value.status_code == 503
+
+
+def test_rpc_preserves_502_and_503_mappings(monkeypatch):
+    settings = Settings()
+
+    monkeypatch.setattr(stellar, "_http_client", lambda timeout: _StubHttpClient(post_status=500))
+    with pytest.raises(HTTPException) as status_error:
+        stellar._rpc("getHealth", {}, settings=settings)
+    assert status_error.value.status_code == 502
+
+    monkeypatch.setattr(stellar, "_http_client", lambda timeout: _StubHttpClient(offline=True))
+    with pytest.raises(HTTPException) as offline_error:
+        stellar._rpc("getHealth", {}, settings=settings)
+    assert offline_error.value.status_code == 503
