{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thebrazenbeard/discovery/schemas/discovery_candidate_v1.schema.json",
  "title": "Discovery Candidate V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "title",
    "status",
    "claim",
    "consumers",
    "preserved_boundaries",
    "promotion_evidence",
    "rejection_conditions",
    "hostile_review"
  ],
  "properties": {
    "schema_version": {
      "const": "DISCOVERY_CANDIDATE_V1"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "OBSERVED",
        "HYPOTHESIS",
        "EXPERIMENTING",
        "PROVEN_REUSABLE",
        "PROJECT_SPECIFIC",
        "REJECTED",
        "SUPERSEDED"
      ]
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "consumers": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repo",
          "role"
        ],
        "properties": {
          "repo": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "visibility": {
            "enum": [
              "PUBLIC",
              "PRIVATE_OPAQUE"
            ]
          },
          "private_attestation": {
            "$ref": "#/$defs/privateSubjectAttestation"
          }
        }
      }
    },
    "preserved_boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "promotion_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rejection_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "hostile_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "critical_objections"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_RUN",
            "FAIL",
            "PASS_WITH_LIMITS",
            "PASS"
          ]
        },
        "critical_objections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "EXPERIMENTING",
              "PROVEN_REUSABLE"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "consumers": {
            "items": {
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "visibility": {
                        "const": "PRIVATE_OPAQUE"
                      }
                    },
                    "required": [
                      "visibility"
                    ]
                  },
                  "then": {
                    "required": [
                      "ref",
                      "private_attestation"
                    ],
                    "properties": {
                      "repo": {
                        "type": "string",
                        "pattern": "^PRIVATE_OPAQUE_[0-9a-f]{16}$"
                      },
                      "ref": {
                        "type": "null"
                      },
                      "private_attestation": {
                        "$ref": "#/$defs/privateSubjectAttestation"
                      }
                    }
                  },
                  "else": {
                    "required": [
                      "ref"
                    ],
                    "properties": {
                      "ref": {
                        "type": "string",
                        "pattern": "^(?:[0-9a-f]{40}|[^@\\s]+@[0-9a-f]{40})$"
                      }
                    }
                  }
                }
              ]
            }
          },
          "promotion_evidence": {
            "minItems": 1
          },
          "hostile_review": {
            "properties": {
              "status": {
                "enum": [
                  "FAIL",
                  "PASS_WITH_LIMITS",
                  "PASS"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "PROVEN_REUSABLE"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "promotion_evidence": {
            "minItems": 2
          },
          "hostile_review": {
            "properties": {
              "status": {
                "const": "PASS"
              },
              "critical_objections": {
                "maxItems": 0
              }
            }
          },
          "consumers": {
            "not": {
              "contains": {
                "properties": {
                  "visibility": {
                    "const": "PRIVATE_OPAQUE"
                  }
                },
                "required": [
                  "visibility"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "privateSubjectAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "commitment_scheme",
        "consumer_commitment_sha256",
        "subject_commitment_sha256",
        "receipt_sha256",
        "verifier_class",
        "status"
      ],
      "properties": {
        "schema": {
          "const": "DISCOVERY_PRIVATE_SUBJECT_ATTESTATION_V1"
        },
        "consumer_commitment_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "subject_commitment_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verifier_class": {
          "enum": [
            "PRIVATE_OWNER_REGISTRY",
            "INDEPENDENT_PRIVATE_REVIEWER"
          ]
        },
        "status": {
          "const": "EXACT_PRIVATE_SUBJECT_ATTESTED"
        },
        "commitment_scheme": {
          "const": "SHA256_PRIVATE_NONCE_CANONICAL_V1"
        }
      }
    }
  }
}
